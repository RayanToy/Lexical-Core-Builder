# ──────────────────────────────────────────────────────────────────────────────
# Lexical Core Builder — пример конфигурации
# Скопируйте этот файл в config.yaml и укажите реальные пути.
# config.yaml добавлен в .gitignore (не попадает в репозиторий).
# ──────────────────────────────────────────────────────────────────────────────

# Базовая директория с предметными списками по классам
# Ожидаемая структура:
#   base_dir/
#     5 класс списки/
#       Bi/
#         Общий частотный список/
#           Общий частотный список Bi 5 класс.xlsx
#         учебник_46852.xlsx
#       ...
base_dir: "/path/to/your/lexical_lists"

# Резервная папка с агрегированными общими частотными списками
common_fallback_dir: "/path/to/your/fallback_lists"

# Папка с покнижными списками общеупотребительной лексики
common_books_dir: "/path/to/your/books_lists"

# ─── Пороги (можно не менять) ─────────────────────────────────────────────────
coverage_threshold: 70       # % учебников, в которых должно быть слово
norm_freq_threshold: 20      # минимальная нормализованная частотность
common_kv_min_threshold: 7   # минимальная сумма слов для общеупотребительной лексики
norm_base: 1000000           # база нормализации (на N слов)
add_common_nf_column: false  # добавлять ли столбец "НЧ (общеупотр.)"